# mtime・inode・外部保存先を含む端末固有の索引と移動中の操作記録。
# 再開に必要なJSON台帳、承認・集計・hash記録は残す。
research/experiments/*/control/*.sqlite
research/experiments/*/control/*.sqlite-*
research/storage-migrations/**/manifest.sqlite
research/storage-migrations/**/manifest.sqlite-*
research/storage-migrations/**/before.json
research/storage-migrations/**/directory-mode-adjustments.jsonl

# pip で展開した依存ライブラリと取得 wheel。metadata/wheels/ の取得記録は残す。
research/experiments/**/packages/
research/experiments/**/packages-*/
research/experiments/*/campaigns/*/wheels/

# 再ビルド可能なネイティブライブラリ。shim と vendor のソースは残す。
research/experiments/**/*.dylib
research/experiments/**/*.so
research/experiments/**/*.o
research/experiments/**/*.a
research/experiments/**/*.dll

# 実行時の排他ロックと標準出力ログ。依存固定用 *.lock は一括除外しない。
research/experiments/**/.lock
research/experiments/**/.run.lock
research/experiments/**/.ai.lock
research/experiments/**/.registration.lock
research/experiments/autonomous-research-cycle/control/lock
research/experiments/**/*.log
# 回答・manifest・hash固定記録、state.json・jobs.jsonl等の予算台帳は残す。
# OSメタデータを証拠保存した実体リンクは除外し、観測JSONを残す。
research/experiments/**/storage-os-metadata-*/*.dsstore

web/**/node_modules/
web/**/dist/

