research/data/**/*.tar.*
research/data/**/*.gz
research/data/**/*.xz
research/data/**/*.zst
research/experiments/**/*.tar
research/experiments/**/*.tar.*
research/experiments/**/*.gz
research/experiments/**/*.xz
research/experiments/**/*.zst

