# 音声研究用の参考データ。管理用ファイルだけを追跡する。
research/data/raw/reference/*
!research/data/raw/reference/.gitkeep
!research/data/raw/reference/utau-samples/
research/data/raw/reference/utau-samples/*
!research/data/raw/reference/utau-samples/README.md

# 研究で生成・分析した音声/画像アーティファクト。
# CSV/Markdown/スクリプトを成果物として残し、重い WAV/PNG は必要時に再生成する。
research/data/**/*.wav
research/data/**/*.png
research/notebooks/*.png
# 新しい実験や試聴用コピー・音量確認音も共通で除外する。
# 回答・操作履歴・manifest・hash固定用lockは研究記録として残す。
research/experiments/*/results/**/*.wav
research/experiments/*/results/**/*.png

web/**/node_modules/
web/**/dist/
