{
  "version": "export-v1",
  "allow_modules": [
    "__init__.py",
    "generator.py",
    "gestures.py"
  ],
  "allow_data": [
    "voice-config.json"
  ],
  "allow_dependencies": [
    "numpy",
    "scipy"
  ],
  "forbid_extensions": [
    ".wav",
    ".mp3",
    ".flac",
    ".pt",
    ".pth",
    ".onnx",
    ".npy",
    ".npz"
  ],
  "forbid_runtime": [
    "reference",
    "neural-model",
    "network"
  ],
  "max_voice_config_bytes": 12000,
  "max_numeric_coefficients": 128,
  "allowed_states": [
    "signal-qualified",
    "inconclusive",
    "autonomously-validated"
  ],
  "research_only": true
}
