(version 1)
(deny default)
(allow process-exec process-fork sysctl-read mach-lookup)
(allow file-read* (subpath "/System") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/Library/Apple") (subpath "/opt/homebrew") (subpath "/Users/dolphilia/github/voice-simulator/research/.venv") (subpath "/Users/dolphilia/github/voice-simulator/research/experiments/autonomous-speech-synthesis/results/ans-pilot-v1/bundle") (literal "/dev/urandom") (literal "/dev/null"))
(allow file-write* (literal "/Users/dolphilia/github/voice-simulator/research/experiments/autonomous-speech-synthesis/results/ans-pilot-v1/os-isolated-unknown.wav"))
