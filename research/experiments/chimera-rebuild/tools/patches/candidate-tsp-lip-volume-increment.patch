+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn volume_decrease_combines_area_and_length_with_the_cell_floor() {
+        let before = Section {
+            area_cm2: 1.5,
+            length_cm: 0.5,
+            minimum_area_cm2: 0.0,
+            perimeter_factor: 1.0,
+            viscous_factor: 1.0,
+            wall: None,
+        };
+        let after = Section { area_cm2: 0.75, length_cm: 0.75, ..before };
+        assert_eq!(volume_decrease(before, after), 0.1875);
+        assert_eq!(volume_decrease(after, before), -0.1875);
+        let narrow_before = Section { area_cm2: 0.01, ..before };
+        let narrow_after = Section { area_cm2: 0.0, length_cm: 0.25, ..before };
+        assert_eq!(volume_decrease(narrow_before, narrow_after), MIN_CELL_AREA_CM2 / 4.0);
+    }
