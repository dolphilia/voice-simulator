+// 前後のセル体積を別々に丸めず、面積と長さの変化を使って体積減少量を求める。
+fn volume_decrease(before: Section, after: Section) -> f64 {
+    let before_area = before.area_cm2.max(MIN_CELL_AREA_CM2);
+    let after_area = after.area_cm2.max(MIN_CELL_AREA_CM2);
+    (before_area - after_area) * before.length_cm
+        + after_area * (before.length_cm - after.length_cm)
 }
 
