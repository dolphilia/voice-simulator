  "commands": [
    {
      "argv": [
        "npx",
        "--yes",
        "--package=bun@1.4.4",
        "--",
        "bun",
        "run",
        "build"
      ],
      "cwd": "$REPOSITORY/web/prototypes/chimera-research",
      "exit_code": 0
    },
    {
      "argv": [
        "node",
        "$REPOSITORY/web/prototypes/chimera-research/tools/capture-worklet.mjs",
        "$ARTIFACTS",
        "$WORKSPACE/cases/worklet-live-beatbox.json",
        "$WORKSPACE/cases/beatbox-pattern-transport.json"
      ],
      "cwd": "$WORKSPACE",
      "exit_code": 0
    },
    {
      "argv": [
        "cargo",
        "run",
        "--locked",
        "--release",
        "-p",
        "vocal-cli",
        "--",
        "inspect",
        "$ARTIFACTS/browser-case.json"
      ],
      "cwd": "$WORKSPACE",
      "exit_code": 0
    },
    {
      "argv": [
        "cargo",
        "run",
        "--locked",
        "--release",
        "-p",
        "vocal-cli",
        "--",
        "render",
        "$ARTIFACTS/browser-case.json",
        "$ARTIFACTS/trace.csv"
      ],
      "cwd": "$WORKSPACE",
      "exit_code": 0
    },
    {
      "argv": [
        "cargo",
        "run",
        "--locked",
        "--release",
        "-p",
        "vocal-cli",
        "--",
        "render-pcm",
        "$ARTIFACTS/browser-case.json",
        "$ARTIFACTS/pcm-128.wav",
        "$ARTIFACTS/pcm-128.csv",
        "128"
      ],
      "cwd": "$WORKSPACE",
